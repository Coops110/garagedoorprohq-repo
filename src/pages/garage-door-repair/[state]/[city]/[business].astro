---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import BizCard from '../../../../components/BizCard.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import { SITE, CLAIMS } from '../../../../lib/site.js';
import {
  getAllBusinesses, getBusiness, getBusinessesByCity, nearbyInCity, telHref, formatPhone, siteFactsFor,
} from '../../../../lib/data.js';
import { licenceInfo, licenceIsCurrent } from '../../../../lib/licensing.js';
import { getGuide } from '../../../../lib/guides.js';
import { breadcrumbSchema, businessSchema } from '../../../../lib/schema.js';
import { fitTitle, fitDescription, clamp } from '../../../../lib/seo.js';
import attribution from '../../../../data/overture-attribution.json';

export function getStaticPaths() {
  return getAllBusinesses().map((b) => ({
    params: { state: b.stateSlug, city: b.citySlug, business: b.slug },
  }));
}

const { state, city, business } = Astro.params;
const b = getBusiness(state, city, business);
const nearby = nearbyInCity(b, 3);

const lic = licenceInfo(b.stateCode);
// An expired register record makes the badge a false claim, so the badge
// tests the expiry date and not just the presence of a number. The block
// below then says what expired and when, which is more useful to a
// homeowner than silence and keeps the real register data on the page.
const licenceCurrent = licenceIsCurrent(b);
const facts = siteFactsFor(b);
// Guides matched to what this company advertises. Only fires where the
// business actually claims the service, so a listing with no self-declared
// facts simply gets the two generic links above and nothing invented.
const GUIDE_FOR_SERVICE = [
  ['spring repair', 'torsion-vs-extension-springs', 'torsion vs extension springs'],
  ['opener repair', 'garage-door-opener-wont-work', 'why an opener stops working'],
  ['cable repair', 'why-diy-spring-repair-is-dangerous', 'why cable and spring work is not a DIY job'],
];
const claimed = new Set(facts?.services || []);
const relatedGuides = GUIDE_FOR_SERVICE
  .filter(([service]) => claimed.has(service))
  .map(([, slug, label]) => ({ slug, label }))
  .slice(0, 2);

const base = SITE.domain.replace(/\/$/, '');
const path = `/garage-door-repair/${state}/${city}/${business}/`;
const tel = telHref(b.phone);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Garage door directory', url: '/garage-door-repair/' },
  { name: b.state, url: `/garage-door-repair/${state}/` },
  { name: b.city, url: `/garage-door-repair/${state}/${city}/` },
  { name: b.name, url: path },
];

const schemas = [breadcrumbSchema(crumbs), businessSchema(b, base + path)];

// Cost context from our own guides, same figures as everywhere else.
const repair = getGuide('garage-door-repair-cost');
const costRows = (repair?.costTable?.rows || []).filter(([job]) =>
  /service call|torsion spring — pair|opener repair|opener replacement/i.test(job));

// Map is embedded only when we actually have coordinates. An iframe pointing
// at a query built from a partial address drops a pin in the wrong place,
// which is worse than no map on a page whose whole job is "where are they".
const mapEmbed = b.lat != null && b.lng != null
  ? `https://maps.google.com/maps?q=${b.lat},${b.lng}&z=14&output=embed`
  : null;
---
<BaseLayout
  title={fitTitle(
    `${b.name} — Garage Doors in ${b.city}, ${b.stateCode}`,
    `${b.name} — ${b.city}, ${b.stateCode}`,
    `${clamp(b.name, 40)} — ${b.city}, ${b.stateCode}`,
    clamp(b.name, 58),
  )}
  description={fitDescription(
    `${b.name} is a garage door company in ${b.city}, ${b.stateCode}. Contact details, service categories${b.licenceNumber ? ' and license verification' : ''} and local repair costs.`,
    `${b.name} — garage door company in ${b.city}, ${b.stateCode}. Phone number, services and what local garage door repairs typically cost.`,
    `Garage door company in ${b.city}, ${b.stateCode}. Phone number, service categories and what local garage door repair and installation typically costs.`,
  )}
  canonical={path}
  image="/og/directory.png"
  imageAlt={`${b.name} — a garage door company listed in ${b.city}, ${b.stateCode}`}
  schemas={schemas}
  type="article"
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />

    <div class="biz-layout">
      <div>
        <div style="display:flex;gap:.4rem;margin-bottom:.6rem;flex-wrap:wrap;">
          {licenceCurrent && <span class="badge badge-license">✓ State license verified</span>}
          {b.services?.[0] && <span class="badge badge-cat">{b.services[0]}</span>}
        </div>

        <h1 style="margin-bottom:.5rem;">{b.name}</h1>
        <p class="muted mb-3">
          {b.street ? `${b.street}, ` : ''}{b.city}, {b.stateCode}{b.postalCode ? ` ${b.postalCode}` : ''}
        </p>

        {b.licenceNumber && !licenceCurrent ? (
          /* The register showed this license expired. We keep the number and
             the dates, because they are still facts we hold, and drop every
             word that implies a current verification. */
          <div class="claim-note">
            <p style="margin:0 0 .5rem;">
              <strong>License #{b.licenceNumber}</strong>: the
              {' '}<a href={lic?.searchUrl} rel="nofollow noopener" target="_blank">{lic?.authorityShort}</a>
              {' '}register showed this license expired on {b.licenceExpires}
              {b.licenceCheckedOn ? ` when we last checked on ${b.licenceCheckedOn}` : ''}, so this
              listing shows no verified-license badge.
            </p>
            <p style="margin:0;">
              That is not a finding against the company. Licenses are renewed
              routinely and our copy of the register is only as current as the date
              above. Ask them for the current number and check it yourself on the
              {' '}<a href={lic?.searchUrl} rel="nofollow noopener" target="_blank">{lic?.authorityShort} register</a>
              {' '}before work starts. It takes about a minute.
            </p>
          </div>
        ) : b.licenceNumber ? (
          /* Everything asserted here is a fact from the register, plus the date
             we read it. The expiry and classification are shown because they are
             the two things that decide whether the badge still means anything
             tomorrow — a license number alone invites the reader to assume more
             than we checked. */
          <div class="claim-note">
            <p style="margin:0 0 .5rem;">
              <strong>License #{b.licenceNumber}</strong> — matched to
              {' '}{b.licenceStatus ? `an ${b.licenceStatus.toLowerCase()} record` : 'an active record'} on the
              {' '}<a href={lic?.searchUrl} rel="nofollow noopener" target="_blank">{lic?.authority}</a>
              {' '}register{b.licenceCheckedOn ? ` when we last checked on ${b.licenceCheckedOn}` : ''}.
            </p>
            <ul style="margin:0 0 .5rem 1.1rem;padding:0;font-size:.85rem;">
              {b.licenceClass && <li>Classification: {b.licenceClass}</li>}
              {b.licenceExpires && <li>Register shows it valid to {b.licenceExpires}</li>}
            </ul>
            <p style="margin:0;">
              {CLAIMS.licenceMeaning} We do not re-check between data refreshes, so
              confirm it yourself on the
              {' '}<a href={lic?.searchUrl} rel="nofollow noopener" target="_blank">{lic?.authorityShort} register</a>
              {' '}before work starts — it takes about a minute.
            </p>
          </div>
        ) : (
          <p class="claim-note">
            {lic
              ? `We have not matched ${lic.article} ${lic.authorityShort} license number to this business. That is not a finding against the company — it may hold a license under a different registered name. Ask them for the number and check it yourself on the ${lic.authorityShort} register.`
              : `${b.state} does not license garage door installation as a separate trade, so there is no state garage door register to check. Ask for a certificate of general liability insurance instead.`}
          </p>
        )}

        <div style="display:flex;gap:.6rem;flex-wrap:wrap;margin-bottom:1.5rem;">
          {tel && <a href={tel} class="btn btn-signal">Call {formatPhone(b.phone)}</a>}
          {b.website && (
            <a href={b.website} class="btn btn-ghost" rel="nofollow noopener" target="_blank">
              Visit website
            </a>
          )}
        </div>

        {/* THE ONLY GENUINELY PER-BUSINESS SECTION ON THIS PAGE, which is why
            it sits above the templated prose rather than below it. The
            2026-10-21 audit's finding was that these pages are 291-430 words
            at about 95% boilerplate and that two of them differed only by a
            street address. Everything below this block is written from a
            template; this is the part that is actually about this company.

            The heading carries the provenance. "What X says about itself" is
            not a stylistic choice — a reader must be able to tell this from
            the license badge at a glance, because the badge means a number
            was checked against a state register and this means nobody checked
            anything. Burying that in a footnote would quietly borrow the
            badge's credibility for marketing copy. */}
        {facts && (
          <section class="section-sm">
            <h2 style="font-size:1.25rem;">What {b.name} says about itself</h2>
            <p class="claim-note">
              {CLAIMS.siteFactsMeaning} Read on {facts.capturedOn}.
            </p>
            <dl class="fact-list">
              {facts.services?.length > 0 && (
                <>
                  <dt>Services it lists</dt>
                  <dd>{facts.services.join(', ')}</dd>
                </>
              )}
              {facts.brands?.length > 0 && (
                <>
                  <dt>Opener brands it names</dt>
                  <dd>{facts.brands.join(', ')}</dd>
                </>
              )}
              {facts.since && (
                <>
                  <dt>Says it has traded since</dt>
                  <dd>{facts.since} ({new Date().getFullYear() - facts.since} years)</dd>
                </>
              )}
              {(facts.familyOwned || facts.claimsBondedInsured) && (
                <>
                  <dt>Also describes itself as</dt>
                  <dd>
                    {[
                      facts.familyOwned && 'family-owned',
                      facts.claimsBondedInsured && 'bonded and insured',
                    ].filter(Boolean).join(', ')}
                  </dd>
                </>
              )}
            </dl>
            <p class="muted" style="font-size:.85rem;margin-top:.6rem;">
              {lic
                ? `A company can say it is insured; only the license number above can be checked against the ${lic.authority} register.`
                : `Garage door work is not licensed as a separate trade in ${b.state}, so ask for proof of insurance in writing rather than taking a website’s word for it.`}
            </p>
          </section>
        )}

        <section class="prose">
          <h2>About this listing</h2>
          <p>
            <strong>{b.name}</strong> is listed as a garage door business in
            {' '}{b.city}, {b.stateCode}
            {b.services?.length > 1
              ? `, categorized in our source data as ${b.services.slice(0, 3).join(', ').toLowerCase()}`
              : ''}.
            {' '}{CLAIMS.listingMeaning} We have not visited this business, inspected
            its work, or spoken to its customers.
          </p>
          <p>
            {lic
              ? `Garage door work is a licensed trade in ${b.state} — the ${lic.authority} issues ${lic.classification}. That makes the license number the one credential you can verify yourself in about a minute, and it is worth doing before any work starts.`
              : `Garage door work is not licensed as a separate trade in ${b.state}, so ask for proof of general liability insurance rather than a license number, and check whether ${b.city} requires a permit for your job.`}
          </p>
          <p>
            Before you call, it helps to know the going rate. Our
            {' '}<a href="/guides/garage-door-repair-cost/">garage door repair cost guide</a>
            {' '}breaks down every common job, and the
            {' '}<a href="/guides/hiring-a-garage-door-company/">hiring checklist</a>
            {' '}covers the four questions that reveal whether a quote is fair.
          </p>
          {/* Every listing page linked the same two guides, 780 times. The
              effect was not neutral: /guides/garage-door-repair-cost/ and
              /guides/hiring-a-garage-door-company/ ended on 887 and 880
              inbound links while garage-door-maintenance had 5,
              torsion-vs-extension-springs 7 and garage-door-opener-wont-work
              9 — three guides published this week sitting as near-orphans
              behind two that are also in the sitewide nav.

              These extra links are chosen by what the company SAYS IT DOES,
              not rotated to spread equity around. A business advertising
              spring repair gets the springs guide because that is the useful
              page for someone reading about them; the link distribution
              improving is a consequence of relevance, not the reason for it.
              A page built to move PageRank rather than to help a reader is
              the thing the audit's helpful-content findings are about. */}
          {relatedGuides.length > 0 && (
            <p>
              {b.name} lists {relatedGuides.length > 1 ? 'work covered by these guides' : 'work covered by this guide'}:
              {' '}{relatedGuides.map((g, i) => (
                <>
                  {i > 0 && (i === relatedGuides.length - 1 ? ' and ' : ', ')}
                  <a href={`/guides/${g.slug}/`}>{g.label}</a>
                </>
              ))}.
            </p>
          )}
        </section>

        <section class="section-sm">
          <h2 style="font-size:1.25rem;">What to expect to pay</h2>
          <div class="table-scroll">
            <table class="cost-table">
              <caption>National 2026 estimates from our own cost guides (<a href="/how-we-price/">how we work them out</a>) — not quotes from {b.name}</caption>
              <thead>
                <tr><th scope="col">Job</th><th scope="col" style="text-align:right;">Typical cost</th></tr>
              </thead>
              <tbody>
                {costRows.map(([job, cost]) => (
                  <tr><td>{job}</td><td class="num">{cost}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {mapEmbed && (
          <section class="section-sm">
            <h2 style="font-size:1.25rem;">Location</h2>
            {/* CLICK TO LOAD. The embedded Google map cost about 420 KB and
                14 scripts on every listing page and drove total blocking
                time to 570ms — the single worst performance item on the
                site, on a page most visitors reach to find a phone number
                rather than a map. loading="lazy" did not help: these pages
                are short enough that the map is usually in or near the
                viewport on arrival.

                Progressive enhancement, same approach as the comparison
                table: with JavaScript off this is a real link that opens
                the map on Google. With JavaScript on, the click swaps in
                the iframe in place. Nothing is fetched from Google until a
                visitor asks for it, so the default page makes no
                third-party request at all.

                The placeholder reserves the same 300px the iframe occupies,
                so the swap shifts nothing. CLS on these pages is 0 and this
                keeps it there. */}
            <a
              class="map-stub"
              href={`https://maps.google.com/maps?q=${b.lat},${b.lng}&z=14`}
              data-map-src={mapEmbed}
              rel="noopener"
              target="_blank"
            >
              <span class="map-stub-icon">
                {/* aria-hidden belongs on the <svg>, not the wrapping span:
                    check-seo.py audits the svg element itself, and the
                    adjacent text already says "Show map", so announcing the
                    pin again would be noise. */}
                <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
              </span>
              <span class="map-stub-text">
                <strong>Show map</strong>
                <span class="muted" style="font-size:.82rem;">
                  {b.street ? `${b.street}, ` : ''}{b.city}, {b.stateCode}
                </span>
              </span>
            </a>
            <script is:inline>
              document.querySelectorAll('.map-stub').forEach(function (stub) {
                stub.addEventListener('click', function (e) {
                  var src = stub.getAttribute('data-map-src');
                  if (!src) return;            // no embed URL: let the link work
                  e.preventDefault();
                  var f = document.createElement('iframe');
                  f.src = src;
                  f.title = stub.querySelector('.map-stub-text strong').textContent;
                  f.loading = 'lazy';
                  f.referrerPolicy = 'no-referrer-when-downgrade';
                  f.className = 'map-frame';
                  stub.replaceWith(f);
                });
              });
            </script>
            <p class="muted mt-1" style="font-size:.8rem;">
              Coordinates from {attribution.source}. The pin is the recorded business
              location, which for a mobile service company may be an office rather
              than a place to visit.
            </p>
          </section>
        )}

        <AdSlot label="Advertisement" />
      </div>

      <aside>
        {nearby.length > 0 && (
          <>
            <h2 style="font-size:1.1rem;margin-bottom:.75rem;">
              Other garage door companies in {b.city}
            </h2>
            <div class="grid" style="gap:.75rem;">
              {nearby.map((n) => <BizCard biz={n} />)}
            </div>
          </>
        )}
        <p class="mt-3">
          <a href={`/garage-door-repair/${state}/${city}/`}>← All {b.city} companies</a>
        </p>
        <p class="claim-note mt-3">
          Is this your business and something here is wrong?
          {' '}<a href="/contact/">Tell us</a> and we will correct or remove it.
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>
