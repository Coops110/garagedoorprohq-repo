---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import BizCard from '../../../../components/BizCard.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import { SITE, CLAIMS, THIN_CITY_NOINDEX_MAX } from '../../../../lib/site.js';
import {
  getAllCities, getCity, getBusinessesByCity, formatCount, formatPhone,
  advertisesEmergency,
} from '../../../../lib/data.js';
import { licenceInfo, noLicenceGuidance } from '../../../../lib/licensing.js';
import { getGuide } from '../../../../lib/guides.js';
import {
  breadcrumbSchema, itemListSchema, faqSchema,
} from '../../../../lib/schema.js';
import { fitTitle, fitDescription } from '../../../../lib/seo.js';

export function getStaticPaths() {
  return getAllCities().map((c) => ({
    params: { state: c.stateSlug, city: c.citySlug },
  }));
}

const { state, city } = Astro.params;
const c = getCity(state, city);
const businesses = getBusinessesByCity(state, city);
const lic = licenceInfo(c.stateCode);

// Published, not indexed. See THIN_CITY_NOINDEX_MAX in site.js for the
// decision and its blast radius. `followLinks` is the important half: this
// page is the only internal link to the listings inside it.
const thinCity = c.count <= THIN_CITY_NOINDEX_MAX;

const cityUrl = `/garage-door-repair/${state}/${city}/`;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Garage door directory', url: '/garage-door-repair/' },
  { name: c.state, url: `/garage-door-repair/${state}/` },
  { name: c.city, url: cityUrl },
];

// Cost context pulled from our own guides, so a city page can never quote a
// figure the guide contradicts. AirProHQ's lesson: numbers that disagree
// across neighboring pages are the fastest way to lose a reader's trust,
// and the only reliable fix is one source of truth.
const repair = getGuide('garage-door-repair-cost');
const costRows = (repair?.costTable?.rows || []).filter(([job]) =>
  /service call|torsion spring — pair|opener repair|off-track|panel replacement|opener replacement|after-hours/i.test(job));

// The after-hours premium is READ from the repair-cost guide, never restated.
// It is quoted in the "door stuck" box below as well as in the table, and a
// figure typed out twice on one page is a figure that will eventually
// disagree with itself.
const afterHours = (repair?.costTable?.rows || [])
  .find(([job]) => /after-hours/i.test(job))?.[1] || '';

// Listings whose own website advertises 24/7 or emergency callout. The page
// held this data and did nothing with it: Houston tags 43 of its 124, Phoenix
// 18 of 47. Because a card renders only its first three service tags, most of
// those were not even visible, let alone reachable as a group.
//
// Surfaced as an anchor to a list further down the page, NOT as a JavaScript
// filter. This audience is standing in a driveway on a phone, and an anchor
// works before any script has run, with no new tap targets to get wrong.
const emergency = businesses.filter(advertisesEmergency);
// Agreement is templated across 84 cities and 22 of them have none, so every
// variant has to read right. "1 company ... that advertise" shipped on the
// first build of this; the site has already had "1 Garage Door Companies in
// Goodyear, AZ" once, for exactly this reason.
const emWord = emergency.length === 1 ? 'one' : formatCount(emergency.length);
const emNoun = emergency.length === 1 ? 'company' : 'companies';
const emVerb = emergency.length === 1 ? 'advertises' : 'advertise';

// How many listings here carry a matched licence, stated INCLUDING when the
// answer is none.
//
// The old clause was `lic && c.licensedCount ? ... : ''`, so a licensing
// state with zero matches said nothing at all. Phoenix has 46 listings and 0
// matched numbers, and the page simply did not mention licensing counts --
// the 2026-11-02 audit's finding. Silence there is the worst available
// answer, because the whole site is built on the badge meaning something, so
// a reader is entitled to know when it is absent everywhere and why.
//
// "we have not matched one" rather than "they are unlicensed" is the
// important half. In Arizona in particular a company may well hold a
// perfectly good ROC licence that we simply have not tied to this record.
//
// Four cases, not two, because the first version shipped "of which 1 have a
// license number" to Torrance and five other cities. 11 of the 17 cities
// with a badge have exactly one, so the singular is the COMMON case here,
// and "all of them" would read oddly on a city with a single listing.
const licMatched = `license number matched to an active record on the ${lic?.authorityShort} register`;
const licClause = !lic
  ? ''
  : c.licensedCount === 0
    ? lic.namesTheTrade
      ? `, none of which has a license number matched to ${lic.article} ${lic.authorityShort} record yet — which means we have not matched one, not that they are unlicensed`
      : `, and none of them carries a license badge: ${lic.state} licenses the contractor rather than the trade, so the ${lic.authorityShort} register has no garage door classification for us to check a number against`
    : c.count === 1
      ? `, and it has a ${licMatched}`
      : c.licensedCount === c.count
        ? `, and all of them have a ${licMatched}`
        : c.licensedCount === 1
          ? `, one of which has a ${licMatched}`
          : `, ${c.licensedCount} of which have a ${licMatched}`;

const faqs = [
  {
    q: `How many garage door companies are there in ${c.city}, ${c.stateCode}?`,
    a: `${SITE.name} lists ${c.count} garage door ${c.count === 1 ? 'company' : 'companies'} in ${c.city}, ${c.stateCode}${licClause}. ${CLAIMS.listingMeaning}`,
  },
  {
    // National estimates, said to be national. This read "Most repairs in
    // {City} fall in the $150–$400 range" on all 84 city pages, which
    // contradicted /how-we-price/ -- that page states plainly that we do not
    // publish a metro-level price, because we have no data that would support
    // one. The same array feeds the FAQPage schema, so the old wording was
    // also telling Google we hold local pricing for 84 cities that we do not.
    //
    // The honest version is more useful anyway: it gives the figure, says what
    // it is, and names the thing that actually moves it locally.
    //
    // "a price specific to {City}", NOT "a {City}-specific price": the second
    // read "a Orlando-specific price" on 11 of the 84 cities, in the visible
    // FAQ and in the FAQPage schema both. Phrased to take no article at all,
    // because an a/an helper would still get "a Universal City" wrong -- the
    // test is the sound, not the letter.
    q: `How much does garage door repair cost in ${c.city}?`,
    a: `We do not publish a price specific to ${c.city}, because we have no data that would support one. Our 2026 national estimates: most repairs land in the $150–$400 range, a torsion spring pair runs $250–$550, an opener repair $100–$300, and a replacement opener $300–$700 installed. Expect a $75–$150 diagnostic fee, usually credited against the work. Local labor rates move the figure within each range, and a double-width door can take a job above it: a double-width torsion spring pair runs $350–$600 against $250–$550 for a single-width pair.`,
  },
  {
    q: lic
      ? `Are garage door companies in ${c.city} licensed?`
      : `Do garage door companies in ${c.city} need a license?`,
    a: lic
      ? `${lic.licenceRule} Ask any company for its license number and check it on the ${lic.authorityShort} register yourself — it takes about a minute. ${CLAIMS.licenceMeaning}`
      : `${c.state} does not license garage door installation as a separate trade, so there is no state garage door register to check. Ask for a certificate of general liability insurance instead, and check whether your city requires a permit for the work.`,
  },
  {
    q: `Which garage door company in ${c.city} should I call first?`,
    a: `We do not rank contractors by quality, and any position that has been paid for is labeled as advertising, so treat this list as a starting point rather than a recommendation. Call two or three, ask each for the price split into parts and labor, and ask for the spring cycle rating in writing.`,
  },
];

const schemas = [
  breadcrumbSchema(crumbs),
  itemListSchema(businesses, (b) => `/garage-door-repair/${state}/${city}/${b.slug}/`),
  faqSchema(faqs),
];
---
<BaseLayout
  title={fitTitle(
    // Leads with the query. The old form was "{N} Garage Door Companies in
    // {City}, {ST}", which pushed "garage door repair" out of the title on all
    // 84 city pages -- the 2026-10-31 audit's SXO finding, and the query these
    // pages actually compete for.
    //
    // A ": {N} Companies" variant was tried first and is deliberately NOT
    // here: with " | GarageDoorProHQ" appended it exceeded 60 characters for
    // every one of the 88 cities, so fitTitle fell through to this form every
    // time. A variant that never renders is worse than no variant -- it reads
    // like the count is in the title when it is not. The count is in the meta
    // description and in the H1 subtitle, which is where it is useful.
    //
    // Dropping it also retires "1 Garage Door Companies in Goodyear, AZ",
    // which shipped on every city that fell to a single listing: the subtitle
    // pluralized and the title did not.
    `Garage Door Repair in ${c.city}, ${c.stateCode}`,
    `Garage Doors in ${c.city}, ${c.stateCode}`,
  )}
  description={fitDescription(
    `${c.count} garage door companies in ${c.city}, ${c.stateCode} with phone numbers and service categories${lic ? `, plus how to check ${lic.article} ${lic.authorityShort} license yourself` : ''}.`,
    `${c.count} garage door repair and installation companies in ${c.city}, ${c.stateCode}, with phone numbers, service categories and local cost guidance.`,
  )}
  canonical={cityUrl}
  noindex={thinCity}
  followLinks={thinCity}
  image="/og/directory.png"
  imageAlt={`Garage door companies in ${c.city}, ${c.stateCode} on ${SITE.name}`}
  schemas={schemas}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />

    <span class="eyebrow">{c.city}, {c.stateCode}</span>
    <h1 style="margin:.5rem 0 .5rem;">Garage door repair in {c.city}, {c.stateCode}</h1>
    <p class="muted mb-3">
      {formatCount(c.count)} {c.count === 1 ? 'listing' : 'listings'}
      {c.withAddress ? ` · ${c.withAddress} with a street address` : ''}
      {lic && c.licensedCount ? ` · ${c.licensedCount} license-verified` : ''}
    </p>

    <p class="claim-note">
      {CLAIMS.listingMeaning} We do not rank by quality and no contractor pays for
      placement. <a href="/editorial-guidelines/">How listings are chosen</a>.
    </p>

    <p style="max-width:66ch;margin-bottom:1.5rem;">
      Whether a spring has snapped and the door will not lift, or the opener has
      finally given up, this page gathers the garage door companies operating in
      {' '}{c.city} with their contact details in one place. Call two or three before
      you book — and read our
      {' '}<a href="/guides/hiring-a-garage-door-company/">hiring checklist</a>
      {' '}first so you know which four questions actually reveal a quote.
    </p>

    {/* ─────────────────────────────────────────────────────────
        "Door stuck?" — the audit's highest-severity SXO finding was that a
        city page offered nothing at all to the reader it is most likely to
        have: someone whose door has just failed, on a phone, in a driveway.

        THREE SAFETY LINES AND NOTHING ELSE. Every one of them is a "do not".
        There is no procedure here, no tool, no sequence and no mention of how
        anything is released, and there must never be — the site's whole
        position on spring work is that a partial instruction is more
        dangerous than none, and /guides/why-diy-spring-repair-is-dangerous/
        exists to say so. This box links there; it does not summarise it.

        The after-hours figure is read from the repair-cost guide, so the one
        number in the box cannot drift from the table below it.
        ───────────────────────────────────────────────────────── */}
    <div class="alert-box">
      <span class="alert-label">Door stuck, or a spring has snapped?</span>
      <p>Three things worth knowing before you call anyone:</p>
      <ul style="margin:.7rem 0 0 1.2rem;">
        <li style="margin-bottom:.4rem;">
          <strong>Stop pressing the opener button.</strong> With a spring gone the
          opener is trying to lift the entire weight of the door on its own, and
          that is how one repair becomes two.
        </li>
        <li style="margin-bottom:.4rem;">
          <strong>If the door is closed, leave it closed.</strong> There is nothing
          to be gained by getting it open before a technician is there.
        </li>
        <li style="margin-bottom:.4rem;">
          <strong>Do not touch the springs, the cables or the winding cones</strong>,
          and keep everyone from under a door that is already open. A spring stays
          loaded after it breaks, and on a two-spring door the other one is still
          fully wound.
        </li>
      </ul>
      <p class="mt-2">
        <a href="/guides/why-diy-spring-repair-is-dangerous/">Why spring work is not a DIY job</a>
        {' '}explains what the stored energy actually is. It is deliberately not a
        how-to.
      </p>
      {afterHours && (
        <p class="mt-2">
          Calling out of hours costs more: same-day, evening and weekend work
          typically {afterHours.replace(/^add /, 'adds ')} on top of the prices in
          the table below. If the door is closed and no vehicle is trapped, a normal
          weekday slot is the cheapest decision available to you.
        </p>
      )}
      {emergency.length > 0 && (
        <p class="mt-2">
          <a href="#emergency">
            See the {emWord} {emNoun} in {c.city} that {emVerb} 24/7 or
            emergency service →
          </a>
        </p>
      )}
    </div>

    {/* What the order on this page actually is.
        Neither /editorial-guidelines/ nor /get-listed/ explained it, and
        /get-listed/ only promised that listings are "ordered the same way
        whether anyone pays" — which says what the order is NOT. The 11-02
        audit read the first six Houston cards as a pinned block followed by
        A-Z, which is a reasonable guess and wrong: they are simply the
        highest-confidence records, and the gap after the sixth is the ad
        slot.

        `sortForDisplay` is completeness (licence 4, street 2, website 1),
        then source confidence, then name. Houston splits 112 / 12 across two
        completeness tiers, so almost the whole page is one tier ordered by
        confidence then alphabetically.

        Described, never scored. The confidence value is Overture's measure of
        how sure it is about the RECORD, and printing it would read as a
        rating of the business, which this site has no basis to publish --
        see the note on sortForDisplay in data.js. */}
    <p class="claim-note">
      This order is not a ranking. Listings with a street address and a website
      come first, then those with less on record; within each group we follow how
      confident the public dataset is about the record itself, then alphabetical
      order. That is a measure of the record, not of the company. We do not rank
      by quality, and nothing on this page is paid for.
    </p>

    <div class="grid grid-3">
      {businesses.map((b, i) => (
        <>
          <BizCard biz={b} />
          {i === 5 && (
            <div style="grid-column:1/-1;">
              <AdSlot label="Advertisement" />
            </div>
          )}
        </>
      ))}
    </div>

    {/* The 24/7 list the box above links to. A plain anchored list rather
        than a filtered view of the grid: it repeats only the name and the
        number, which is all the hurried reader wants, and it needs no script.

        CLAIMS.hoursMeaning is rendered verbatim and first. This is the
        company's own marketing claim, not opening hours, and this site does
        not publish opening hours from any source. Presenting a self-declared
        tag as a fact about availability would be exactly the kind of
        over-claim the licence badge rules exist to prevent. */}
    {emergency.length > 0 && (
      <section class="section" id="emergency">
        <h2 style="font-size:1.3rem;">
          The {emWord} {emNoun} in {c.city} that {emVerb} 24/7 or emergency service
        </h2>
        <p class="claim-note">{CLAIMS.hoursMeaning}</p>
        {/* The name links to the profile and the number is plain text, NOT a
            second anchor. `.link-list a` is a 44px flex block, so two anchors
            in one <li> render as two stacked rows and the pairing stops
            reading as one business. The profile one tap away carries the
            Call button. */}
        <ul class="link-list mt-2">
          {emergency.map((b) => (
            <li>
              <a href={`/garage-door-repair/${state}/${city}/${b.slug}/`}>{b.name}</a>
              {b.phone && <span class="n">{formatPhone(b.phone)}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Per-city cost table. Genuinely page-specific rather than boilerplate
        padding: it answers the question someone on this page is about to ask
        a contractor, and every figure comes from our own guide so the two
        cannot drift. */}
    <section class="section">
      {/* Query form, per the 2026-11-02 GEO finding that 0 of 4 city H2s
          were questions. The declarative answer still opens the paragraph
          underneath, which is the part an assistant quotes. */}
      <h2 style="font-size:1.3rem;">What does garage door work cost in {c.city}?</h2>
      <p class="mt-2">
        These are national 2026 estimates from our own
        {' '}<a href="/guides/garage-door-repair-cost/">garage door repair cost guide</a>,
        not quotes from the companies above. Labor rates in {c.city} move the
        figure up or down, and a double-width door can take a job above these ranges
        rather than to the top of them.
      </p>
      {/* City pages carried 0 links to /how-we-price/ while every guide has
          had one under its cost table since October. Same reasoning as there:
          a method nobody can reach from the number it explains is no better
          than no method at all. */}
      <p class="muted" style="font-size:.85rem;">
        <a href="/how-we-price/">How we work these figures out</a> — what they are
        based on, and what they are not.
      </p>
      <div class="table-scroll">
        <table class="cost-table">
          <caption>Typical installed cost by job, 2026 national estimate</caption>
          <thead>
            <tr><th scope="col">Job</th><th scope="col" style="text-align:right;">Typical cost</th></tr>
          </thead>
          <tbody>
            {costRows.map(([job, cost]) => (
              <tr><td>{job}</td><td class="num">{cost}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* License section. In a licensing state this is a walkthrough; in the
        other 47 it explains why there is no badge, which is more useful than
        silence and stops the absence reading as a failed check. */}
    <section class="section-sm">
      <h2 style="font-size:1.3rem;">
        {/* "Check a Orlando contractor" shipped on every city whose name
            starts with a vowel sound -- Orlando, Anaheim, Ontario, Apopka.
            Templated into an h2, so it was wrong on the most visible line of
            the page. Written out as "in {City}" rather than picking a/an:
            a/an by first letter still gets Ontario right and hour wrong, and
            the phrasing reads better than either article anyway. */}
        {lic
          ? `How do you check a contractor's license in ${c.city}?`
          : `What should you ask about licensing and insurance in ${c.state}?`}
      </h2>
      {lic ? (
        <>
          <p class="mt-2">
            {lic.tradeScope} Any company quoting you should give you its license
            number on request, and you can confirm it on the {lic.authority}
            register without any expertise:
          </p>
          <div class="highlight-box">
            <ol style="margin:0 0 0 1.2rem;">
              {lic.verifySteps.map((step) => <li style="margin-bottom:.4rem;">{step}</li>)}
            </ol>
            <p class="mt-2">
              <a href={lic.searchUrl} rel="nofollow noopener" target="_blank">{lic.searchLabel}</a>
              {' '}(opens on the {lic.authorityShort} site)
            </p>
          </div>
          <p>{CLAIMS.licenceMeaning}</p>
          {/* In a licensing state with nothing matched, say so here as well as
              in the FAQ. The two answer different questions: the FAQ answers
              "how many are there", this answers "why is there no badge on any
              of these". Leaving a reader to infer the reason from an absence is
              the one thing the badge rules exist to prevent.

              The reason differs by state, which is why this branches rather than
              interpolating a noun. In California and Florida a match could still
              happen, so "yet" is accurate. In Arizona it never will: the ROC
              licenses the contractor, not the trade, so there is no garage door
              classification to match a number against, and the honest sentence
              is about the register rather than about our matching. "Yet" was
              blaming a gap in our work for a fact about Arizona on 11 city pages
              -- and licClause above hands the same claim to the FAQPage schema. */}
          {c.licensedCount === 0 && (
            lic.namesTheTrade ? (
              <p>
                No listing in {c.city} currently carries a badge: none of the
                {' '}{formatCount(c.count)} {c.count === 1 ? 'company' : 'companies'} here
                has a license number matched to {lic.article} {lic.authorityShort} record
                yet. That is a gap in what we have matched, not a finding about any of
                them, so ask for the number and check it yourself.
              </p>
            ) : (
              <p>
                No listing in {c.city} carries a license badge, and none will:
                {' '}{lic.state} licenses the contractor rather than the trade, so the
                {' '}{lic.authorityShort} register has no garage door classification for us
                to check a number against. That is a fact about the register, not a
                finding about any of the {formatCount(c.count)}
                {' '}{c.count === 1 ? 'company' : 'companies'} here. Any of them may hold
                a current {lic.authorityShort} license, so ask for the number and check it
                yourself.
              </p>
            )
          )}
        </>
      ) : (
        noLicenceGuidance(c.state).map((p) => <p class="mt-2">{p}</p>)
      )}
    </section>

    <section class="section-sm">
      <h2 style="font-size:1.3rem;">Garage doors in {c.city}: common questions</h2>
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </section>

    <section class="section-sm">
      <h2 style="font-size:1.3rem;">Before you call around</h2>
      <p class="mt-2 mb-2">Know the fair price first — or work out what has actually failed.</p>
      {/* Three cost guides and nothing else, on all 84 city pages. The two
          troubleshooting guides and the maintenance pillar were reachable
          only from the guides hub, which is how they ended on 9, 7 and 5
          inbound links against 887 for the repair-cost pillar.

          They belong here on their own merit, not to even out a link graph:
          someone on a city page is deciding who to call, and "what has
          actually failed" and "how to stop it failing again" are the two
          questions either side of that decision. */}
      <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
        <a href="/guides/garage-door-repair-cost/" class="btn btn-ink">Repair cost guide</a>
        <a href="/guides/garage-door-opener-wont-work/" class="btn btn-ghost">Opener not working?</a>
        <a href="/guides/garage-door-spring-replacement-cost/" class="btn btn-ghost">Spring costs</a>
        <a href="/guides/garage-door-opener-repair-cost/" class="btn btn-ghost">Opener costs</a>
        <a href="/guides/garage-door-maintenance/" class="btn btn-ghost">Maintenance</a>
      </div>
      <p class="mt-3">
        <a href={`/garage-door-repair/${state}/`}>← All {c.state} cities</a>
      </p>
    </section>
  </div>
</BaseLayout>
