---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { SITE, CLAIMS } from '../../../lib/site.js';
import {
  getAllStates, getState, getCitiesByState, formatCount, stateFactsSummary,
  getBusinessesByState,
} from '../../../lib/data.js';
import {
  licenceInfo, noLicenceGuidance, licenceIsCurrent, LICENCE_STATES,
} from '../../../lib/licensing.js';
import { breadcrumbSchema, itemListSchema, faqSchema } from '../../../lib/schema.js';
import { fitTitle, fitDescription } from '../../../lib/seo.js';

export function getStaticPaths() {
  return getAllStates().map((s) => ({ params: { state: s.stateSlug } }));
}

const { state } = Astro.params;
const s = getState(state);
const cities = getCitiesByState(state);
const lic = licenceInfo(s.stateCode);
const facts = stateFactsSummary(s.stateCode);

// The badged listings, as a group you can actually get to.
//
// The 2026-11-02 audit found that "26 license-verified" at the top of this
// page was a dead number: the one claim on the whole site that a reader
// cannot check at a glance, and no route to the listings it counts. Worse,
// the SERP for "garage door contractor license california" is made up almost
// entirely of per-contractor licence-record pages, which is exactly the page
// type our verified listings already are. They were unreachable except by
// opening cities one at a time.
//
// Filtered through licenceIsCurrent, the same gate the badge itself uses, so
// this list and the badges can never disagree about who is verified — and so
// the count in the heading stays equal to s.licensedCount, which cities.json
// also computes from badged listings only.
//
// `(b) => licenceIsCurrent(b)` and not a bare `.filter(licenceIsCurrent)`:
// Array.filter passes the index as the second argument, which lands in the
// `asOf` parameter and throws on `asOf.getFullYear`. It failed loudly here,
// which is the good outcome, but the same mistake against a function that
// coerced instead of throwing would have shipped a wrong list quietly.
const verified = lic ? getBusinessesByState(state).filter((b) => licenceIsCurrent(b)) : [];

const url = `/garage-door-repair/${state}/`;
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Garage door directory', url: '/garage-door-repair/' },
  { name: s.state, url },
];

const faqs = [
  {
    q: `How many garage door companies are listed in ${s.state}?`,
    a: `${CLAIMS.listingMeaning.replace(/\.$/, '')} — we list ${s.count} garage door ${s.count === 1 ? 'company' : 'companies'} across ${s.cityCount} ${s.cityCount === 1 ? 'city' : 'cities'} in ${s.state}${lic ? `, of which ${s.licensedCount} have a license number matched to an active record on the ${lic.authorityShort} register` : ''}.`,
  },
  {
    q: `Do garage door installers need a license in ${s.state}?`,
    a: lic
      ? `${lic.licenceRule} You can check any license number yourself on the state register in about a minute.`
      : `Not as a separate trade. ${s.state} has no garage-door-specific state license, so the work falls under a general contractor license, a local registration, or no license at all depending on the job. Ask for proof of liability insurance instead.`,
  },
  {
    q: `How much does garage door repair cost in ${s.state}?`,
    a: `Most garage door repairs run $150–$400 nationally, with springs at $250–$550 for a pair and a new opener at $300–$700 installed. Local labor rates move the figure. See our garage door repair cost guide for the full breakdown by job.`,
  },
];

const schemas = [
  breadcrumbSchema(crumbs),
  itemListSchema(cities.map((c) => ({ name: `${c.city}, ${c.stateCode}`, ...c })),
    (c) => `/garage-door-repair/${c.stateSlug}/${c.citySlug}/`),
  faqSchema(faqs),
];
---
<BaseLayout
  title={fitTitle(
    `Garage Door Repair in ${s.state}: By City`,
    `${s.state} Garage Door Companies`,
  )}
  description={fitDescription(
    `${s.count} garage door companies across ${s.cityCount} ${s.cityCount === 1 ? 'city' : 'cities'} in ${s.state}. Contact details, service categories${lic ? ` and ${lic.authorityShort} license checks` : ''}.`,
    `Garage door repair and installation companies across ${s.cityCount} cities in ${s.state}, with phone numbers, service categories and local cost guidance.`,
  )}
  canonical={url}
  image="/og/directory.png"
  imageAlt={`Garage door companies across ${s.state} on ${SITE.name}`}
  schemas={schemas}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />

    <span class="eyebrow">{s.state}</span>
    {/* Was "Garage door companies in {State}" while the <title> said
        "Garage Door Repair in {State}: By City" — the two most prominent
        strings on the page disagreeing about what it is. Aligned on the
        title's wording rather than the other way round: the August GSC
        export shows "garage door repair {city}" carrying far more
        impressions than the "companies" phrasing, and the title is the
        version already competing for it. The city pages do not have this
        problem — their title and h1 already agree. */}
    <h1 style="margin:.5rem 0 .75rem;">Garage door repair in {s.state}, by city</h1>
    <p class="muted mb-3">
      {formatCount(s.count)} {s.count === 1 ? 'listing' : 'listings'} across
      {' '}{s.cityCount} {s.cityCount === 1 ? 'city' : 'cities'}
      {/* Linked, not stated. See the note on `verified` above. */}
      {lic && verified.length > 0 && (
        <>
          {' · '}
          <a href="#license-verified">{verified.length} license-verified</a>
        </>
      )}
    </p>

    <p class="claim-note">
      {CLAIMS.listingMeaning}
      {lic ? ` ${CLAIMS.licenceMeaning}` : ''}
      {' '}<a href="/editorial-guidelines/">How listings are chosen</a>.
    </p>

    {cities.length > 1 && (
      <p class="mb-3">
        <a href={`/garage-door-repair/${state}/compare/`} class="btn btn-ghost">
          Compare {s.cityCount} {s.state} cities side by side
        </a>
      </p>
    )}

    <h2 style="font-size:1.2rem;">Cities</h2>
    <ul class="link-list mt-2">
      {cities.map((c) => (
        <li>
          <a href={`/garage-door-repair/${c.stateSlug}/${c.citySlug}/`}>
            Garage door repair in {c.city}
          </a>
          <span class="n">{c.count}</span>
        </li>
      ))}
    </ul>

    <section class="section">
      <h2 style="font-size:1.3rem;">
        {lic ? `Garage door licensing in ${s.state}` : `Licensing in ${s.state}`}
      </h2>
      {lic ? (
        <>
          {/* Per-state sentence, NOT a shared one with the classification
              slotted in. Arizona has no garage-door classification, and the
              shared version printed one for two years. See licensing.js. */}
          <p class="mt-2">
            {lic.tradeScope} The {lic.authority} register is public, free and
            searchable by license number or business name.
          </p>
          <div class="highlight-box">
            <h3>Verify a license yourself, in about a minute</h3>
            <ol style="margin:.6rem 0 0 1.2rem;">
              {lic.verifySteps.map((step) => <li style="margin-bottom:.4rem;">{step}</li>)}
            </ol>
            <p class="mt-2">
              <a href={lic.searchUrl} rel="nofollow noopener" target="_blank">{lic.searchLabel}</a>
              {' '}(opens on the {lic.authorityShort} site)
            </p>
          </div>
          <p>{CLAIMS.licenceMeaning}</p>

          {/* The three registers side by side, so a reader who is checking a
              licence can see what each state's actually covers.

              Only on the three hubs that HAVE a register. The same table on
              the Texas hub would be boilerplate on the one page where it is
              least relevant, and "state hubs say nothing that is not equally
              true of every other state" was its own audit finding. Texas
              keeps noLicenceGuidance, which is about Texas.

              Arizona's row is why this is a table and not a sentence: its
              cell says no classification exists, which no shared phrasing
              could carry. */}
          <h3 style="margin-top:1.5rem;">The three state registers, side by side</h3>
          <div class="table-scroll">
            <table class="cost-table">
              <caption>Where garage door work is licensed at state level, and what each register covers</caption>
              <thead>
                <tr>
                  <th scope="col">State</th>
                  <th scope="col">What the register covers</th>
                  <th scope="col">Look it up</th>
                </tr>
              </thead>
              <tbody>
                {Object.values(LICENCE_STATES).map((r) => (
                  <tr>
                    <th scope="row" style="font-weight:600;">{r.state}</th>
                    <td>
                      {r.classification
                        ? `${r.authorityShort} ${r.classification}`
                        : `${r.authorityShort} licenses the contractor, not the trade. No garage-door classification exists; a license is required for any job over $1,000 or needing a permit.`}
                    </td>
                    <td>
                      <a href={r.searchUrl} rel="nofollow noopener" target="_blank">{r.searchLabel}</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="claim-note">
            Everywhere else there is no state garage door register to check, so a
            listing without a badge has not failed a check — there was nothing to
            check against. <a href="/guides/hiring-a-garage-door-company/">What to
            ask instead</a>.
          </p>
        </>
      ) : (
        noLicenceGuidance(s.state).map((p) => <p class="mt-2">{p}</p>)
      )}
    </section>

    {verified.length > 0 && (
      <section class="section" id="license-verified">
        <h2 style="font-size:1.3rem;">
          The {formatCount(verified.length)} license-verified {verified.length === 1 ? 'listing' : 'listings'} in {s.state}
        </h2>
        <p class="claim-note">
          {CLAIMS.licenceMeaning} Each number below was matched to an active record
          on the {lic.authorityShort} register on the date shown on that listing, and
          we do not re-check it afterwards, so confirm it yourself before you book.
          {' '}<a href={lic.searchUrl} rel="nofollow noopener" target="_blank">{lic.searchLabel}</a>.
        </p>
        <ul class="link-list mt-2">
          {verified.map((b) => (
            <li>
              <a href={`/garage-door-repair/${b.stateSlug}/${b.citySlug}/${b.slug}/`}>
                {b.name}
              </a>
              <span class="n">{b.city} · #{b.licenceNumber}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* State hubs were 121-194 words of prose and said nothing that was not
        equally true of every other state — Arizona 276 words, Florida 251,
        which is the audit's "state hubs are thin" finding. This is the part
        that genuinely differs between them: LiftMaster leads in Arizona and
        California, Overhead Door in Florida and Texas, and the median
        founding year spans 1998 to 2006.

        Aggregated from what the companies publish about themselves, so the
        sample size is stated rather than implied — a reader can see it covers
        101 of 157 Arizona listings and weigh it accordingly. */}
    {facts && (
      <section class="section-sm">
        <h2 style="font-size:1.3rem;">What {s.state} companies say they do</h2>
        <p class="claim-note">
          Aggregated from the websites of {formatCount(facts.sampled)} of the
          {' '}{formatCount(facts.ofTotal)} companies listed here. These are their own
          claims, not checks we made.
        </p>
        <ul class="mt-2">
          {facts.services.length > 0 && (
            <li>
              Most commonly advertised:
              {' '}{facts.services.map(([name, n]) => `${name} (${n})`).join(', ')}.
            </li>
          )}
          {facts.brands.length > 0 && (
            <li>
              Opener brands named most often:
              {' '}{facts.brands.map(([name, n]) => `${name} (${n})`).join(', ')}.
            </li>
          )}
          {facts.medianSince && (
            <li>
              Of the {facts.sinceCount} that state a founding year, the median is
              {' '}{facts.medianSince}. Some quote the founding date of a brand they
              carry rather than their own, so treat it as a rough picture.
            </li>
          )}
          {facts.familyOwned > 0 && (
            <li>{facts.familyOwned} describe themselves as family-owned.</li>
          )}
        </ul>
      </section>
    )}

    <section class="section-sm">
      <h2 style="font-size:1.3rem;">Before you call around</h2>
      <p class="mt-2 mb-2">Know the fair price first, so nobody oversells you.</p>
      <div style="display:flex;gap:.6rem;flex-wrap:wrap;">
        <a href="/guides/garage-door-repair-cost/" class="btn btn-ink">Repair cost guide</a>
        <a href="/guides/garage-door-spring-replacement-cost/" class="btn btn-ghost">Spring costs</a>
        <a href="/guides/hiring-a-garage-door-company/" class="btn btn-ghost">How to hire</a>
      </div>
    </section>
  </div>
</BaseLayout>
