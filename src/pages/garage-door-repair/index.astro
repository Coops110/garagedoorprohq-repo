---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE, CLAIMS } from '../../lib/site.js';
import { getAllStates, getAllCities, getSiteStats, formatCount } from '../../lib/data.js';
import { breadcrumbSchema, itemListSchema } from '../../lib/schema.js';
import { fitDescription } from '../../lib/seo.js';

const states = getAllStates();
const cities = getAllCities();
const stats = getSiteStats();

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Garage door directory', url: '/garage-door-repair/' },
];

const schemas = [
  breadcrumbSchema(crumbs),
  ...(states.length
    ? [itemListSchema(
        states.map((s) => ({ name: s.state, stateSlug: s.stateSlug })),
        (s) => `/garage-door-repair/${s.stateSlug}/`
      )]
    : []),
];
---
<BaseLayout
  title="Garage Door Repair Companies by State"
  description={fitDescription(
    `Browse garage door companies by state and city. ${formatCount(stats.businesses)} listings compiled from openly licensed public business data, every one with a phone number.`,
    'Browse garage door repair and installation companies by state and city, compiled from openly licensed public business data, every one with a phone number.',
  )}
  canonical="/garage-door-repair/"
  image="/og/directory.png"
  imageAlt={`Garage door companies by state and city on ${SITE.name}`}
  schemas={schemas}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />

    <span class="eyebrow">Directory</span>
    <h1 style="margin:.5rem 0 .75rem;">Garage door companies by state</h1>

    {states.length > 0 ? (
      <>
        {/* This page was 34 words of prose above a 90-link index — less body
            text than the empty-state branch below it, which is the wrong way
            round. It is the directory's front door and the page that should
            answer "which garage door company do I call", so it now explains
            what the list is before handing over a wall of city names. The
            sections deliberately do not restate the claim-note above: each
            adds something a reader cannot get from the links themselves. */}
        <p style="max-width:62ch;">
          {formatCount(stats.businesses)} garage door companies across {formatCount(stats.cities)}
          {' '}cities, every one with a phone number. Pick a state below, or jump straight to
          a city. What this is not is a ranking, and the short version of why is worth
          reading before you call anyone.
        </p>

        <div class="stat-grid">
          <div class="stat-card">
            <span class="stat-value">{formatCount(stats.businesses)}</span>
            <span class="stat-label">Listings</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">{formatCount(stats.cities)}</span>
            <span class="stat-label">Cities</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">{formatCount(stats.states)}</span>
            <span class="stat-label">States</span>
          </div>
          <div class="stat-card">
            <span class="stat-value">{formatCount(stats.withPhone)}</span>
            <span class="stat-label">With a phone</span>
          </div>
        </div>

        <p class="claim-note">
          {CLAIMS.listingMeaning} {CLAIMS.licenceMeaning}
          <a href="/editorial-guidelines/">How listings are chosen</a>.
        </p>

        <h2 class="mt-4" style="font-size:1.2rem;">There are no star ratings here, and there never will be</h2>
        <p style="max-width:62ch;">
          Every business on this page comes from Foursquare Open Source Places, distributed
          by the Overture Maps Foundation under the Apache 2.0 licence. It is the one
          business dataset that may lawfully be stored and republished, and it contains
          neither ratings nor opening hours.
        </p>
        <p style="max-width:62ch;" class="mt-2">
          The datasets that do contain them forbid rehosting, and buying the same rows from
          a scraper does not change that, because the restriction follows the data. So a
          star rating on this page could only come from somewhere we are not entitled to
          take it from. We would rather show you a phone number we can stand behind than a
          score we cannot.
        </p>

        <h2 class="mt-4" style="font-size:1.2rem;">How to use this list</h2>
        <p style="max-width:62ch;">
          Treat it as a shortlist, not a verdict. Call two or three companies in your city
          rather than the first one, and ask each for the price split into parts and labour —
          it is the fastest way to see whether a quote is high on the component, high on the
          hours, or fair. If springs are involved, ask for the cycle rating in writing.
        </p>
        <p style="max-width:62ch;" class="mt-2">
          California, Florida and Arizona are the only three states that license garage door
          work as its own trade. In those, ask for the licence number and check it on the
          state register yourself — it takes about a minute and it is the one credential a
          homeowner can verify without expertise. In the other 47 there is no register to
          check, so a missing badge means nothing has been checked rather than something has
          failed. <a href="/guides/hiring-a-garage-door-company/">What to ask before you book</a>
          {' '}covers the rest.
        </p>
        <p style="max-width:62ch;" class="mt-2">
          If you are not yet sure what is wrong, start with
          {' '}<a href="/guides/garage-door-opener-wont-work/">the checks that cost nothing</a>.
          If you know what is broken and want the price first,
          {' '}<a href="/guides/garage-door-repair-cost/">what each job actually costs</a>
          {' '}is the page to read before the phone call, not after it.
        </p>

        <h2 class="mt-4" style="font-size:1.2rem;">Why only {formatCount(stats.states)} states so far</h2>
        <p style="max-width:62ch;">
          The directory is being built metro by metro rather than dumped nationally on day
          one. A city page needs at least three listings before it publishes, because one or
          two is too thin to be worth anyone's time. Records held back below that threshold
          are not deleted — they publish automatically once their city reaches it.
        </p>
        <p class="claim-note mt-3">
          Run a garage door company? <a href="/get-listed/">Get listed</a> — listing is free,
          and paying never changes what a listing says.
        </p>

        <h2 class="mt-4" style="font-size:1.2rem;">States</h2>
        <ul class="link-list mt-2">
          {states.map((s) => (
            <li>
              <a href={`/garage-door-repair/${s.stateSlug}/`}>
                {s.state}
              </a>
              <span class="n">{s.cityCount} {s.cityCount === 1 ? 'city' : 'cities'} · {s.count}</span>
            </li>
          ))}
        </ul>

        <h2 class="mt-4" style="font-size:1.2rem;">Cities</h2>
        <ul class="link-list mt-2">
          {cities.map((c) => (
            <li>
              <a href={`/garage-door-repair/${c.stateSlug}/${c.citySlug}/`}>
                {c.city}, {c.stateCode}
              </a>
              <span class="n">{c.count}</span>
            </li>
          ))}
        </ul>
      </>
    ) : (
      /* No listings staged yet. Saying so plainly beats an empty grid that
         looks broken — and this page is in the sitemap from batch 0, before
         any city page exists. */
      <>
        <p style="max-width:60ch;">
          The directory is being built metro by metro rather than dumped nationally
          in one go. Nothing is listed here yet.
        </p>
        <p style="max-width:60ch;" class="mt-2">
          In the meantime, our <a href="/guides/">cost guides</a> cover what garage
          door repairs and replacements actually cost in 2026, and
          <a href="/guides/hiring-a-garage-door-company/">how to hire a garage door company</a>
          {' '}covers what to ask before you book anyone.
        </p>
        <p class="claim-note mt-3">
          Run a garage door company? <a href="/get-listed/">Get listed</a> — listing is free,
          and paying never changes what a listing says.
        </p>
      </>
    )}
  </div>
</BaseLayout>
