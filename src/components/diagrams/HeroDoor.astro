---
// Homepage hero. Decorative rather than explanatory, so it is marked
// aria-hidden and carries no accessible name — a screen reader that announced
// "illustration of a garage door" here would be adding noise, since the heading
// beside it already says what the page is.
//
// A partly-open door with a broken spring visible above it: the exact moment the
// site is for. It is an illustration of the problem, not a photograph of a
// contractor — nothing here implies we have visited anyone.
---
<svg
  viewBox="0 0 480 330" width="480" height="330" aria-hidden="true" focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- house outline -->
  <path d="M30 148 L240 34 L450 148" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round" />
  <rect x="52" y="148" width="376" height="148" fill="var(--card)" stroke="var(--ink)" stroke-width="4" />

  <!-- garage opening -->
  <rect x="96" y="176" width="288" height="120" fill="#EFEDE6" stroke="var(--line)" stroke-width="2" />

  <!-- torsion shaft with a BROKEN spring: the gap is the whole story -->
  <line x1="110" y1="192" x2="370" y2="192" stroke="var(--ink)" stroke-width="5" stroke-linecap="round" />
  <g fill="none" stroke="var(--signal)" stroke-width="3.5">
    {Array.from({ length: 7 }, (_, i) => <ellipse cx={140 + i * 12} cy="192" rx="5" ry="13" />)}
    {Array.from({ length: 7 }, (_, i) => <ellipse cx={268 + i * 12} cy="192" rx="5" ry="13" />)}
  </g>
  <!-- the gap, marked -->
  <line x1="232" y1="178" x2="256" y2="206" stroke="var(--signal)" stroke-width="3" />
  <line x1="256" y1="178" x2="232" y2="206" stroke="var(--signal)" stroke-width="3" />

  <!-- door stuck part way up -->
  <rect x="104" y="212" width="272" height="30" rx="2" fill="#F3F1EA" stroke="var(--ink-soft)" stroke-width="2" />
  <rect x="104" y="246" width="272" height="30" rx="2" fill="#F3F1EA" stroke="var(--ink-soft)" stroke-width="2" />
  <rect x="128" y="221" width="104" height="12" rx="2" fill="none" stroke="var(--line)" stroke-width="2" />
  <rect x="248" y="221" width="104" height="12" rx="2" fill="none" stroke="var(--line)" stroke-width="2" />
  <rect x="128" y="255" width="104" height="12" rx="2" fill="none" stroke="var(--line)" stroke-width="2" />
  <rect x="248" y="255" width="104" height="12" rx="2" fill="none" stroke="var(--line)" stroke-width="2" />

  <!-- tilted, jammed: one side lower than the other -->
  <line x1="96" y1="276" x2="384" y2="284" stroke="var(--signal)" stroke-width="3" stroke-dasharray="7 5" />

  <!-- a window and door on the house, so it reads as a home not a warehouse -->
  <rect x="70" y="176" width="14" height="40" fill="none" stroke="var(--ink-soft)" stroke-width="2" />
  <rect x="396" y="176" width="14" height="40" fill="none" stroke="var(--ink-soft)" stroke-width="2" />

  <!-- ground -->
  <line x1="16" y1="296" x2="464" y2="296" stroke="var(--ink)" stroke-width="4" />
</svg>
