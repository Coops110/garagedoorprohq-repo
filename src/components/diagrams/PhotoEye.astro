---
// Photo-eye sensors: where they sit, what breaks the beam, and what the door
// does about it. This is the single most common call-out that needs no
// technician, so the drawing is worth more here than anywhere else on the site.
const { id = 'dg-photoeye' } = Astro.props;
---
<svg
  viewBox="0 0 560 300" width="560" height="300" role="img"
  aria-labelledby={`${id}-title`} aria-describedby={`${id}-desc`}
  xmlns="http://www.w3.org/2000/svg"
>
  <title id={`${id}-title`}>How garage door photo-eye sensors work</title>
  <desc id={`${id}-desc`}>
    Two sensors face each other about six inches above the floor on either side
    of the opening. One sends an infrared beam to the other. An object breaking
    the beam while the door is closing makes the door reverse and travel back up.
  </desc>

  <rect x="0" y="0" width="560" height="300" fill="var(--paper)" />

  <!-- opening jambs -->
  <rect x="40" y="20" width="18" height="230" fill="#EFEDE6" stroke="var(--line)" stroke-width="2" />
  <rect x="502" y="20" width="18" height="230" fill="#EFEDE6" stroke="var(--line)" stroke-width="2" />

  <!-- part-closed door coming down -->
  {[0, 1].map((i) => (
    <rect x="58" y={26 + i * 44} width="444" height="40" rx="3" fill="#F3F1EA" stroke="var(--ink-soft)" stroke-width="2" />
  ))}

  <!-- travel arrow: door reversing back up -->
  <g stroke="var(--signal)" stroke-width="4" fill="none">
    <line x1="280" y1="150" x2="280" y2="126" />
    <polyline points="268,136 280,122 292,136" stroke-linejoin="round" />
  </g>
  <text x="300" y="146" font-family="Inter, sans-serif" font-size="16" fill="var(--signal)" font-weight="700">
    door reverses
  </text>

  <!-- floor -->
  <line x1="20" y1="250" x2="540" y2="250" stroke="var(--ink)" stroke-width="3" />

  <!-- sensors, about six inches up -->
  <g>
    <rect x="52" y="212" width="20" height="26" rx="4" fill="var(--steel)" />
    <circle cx="72" cy="225" r="5" fill="var(--amber)" />
    <rect x="488" y="212" width="20" height="26" rx="4" fill="var(--steel)" />
    <circle cx="488" cy="225" r="5" fill="var(--amber)" />
  </g>

  <!-- the beam, broken in the middle -->
  <line x1="78" y1="225" x2="248" y2="225" stroke="var(--amber)" stroke-width="3" stroke-dasharray="9 6" />
  <line x1="312" y1="225" x2="482" y2="225" stroke="var(--amber)" stroke-width="3" stroke-dasharray="9 6" />

  <!-- the obstruction breaking it -->
  <rect x="256" y="196" width="48" height="54" rx="4" fill="var(--signal)" opacity="0.18" stroke="var(--signal)" stroke-width="2.5" />
  <line x1="256" y1="196" x2="304" y2="250" stroke="var(--signal)" stroke-width="2" />
  <line x1="304" y1="196" x2="256" y2="250" stroke="var(--signal)" stroke-width="2" />

  <!-- six-inch dimension -->
  <line x1="530" y1="225" x2="530" y2="250" stroke="var(--muted)" stroke-width="1.5" />
  <line x1="524" y1="225" x2="536" y2="225" stroke="var(--muted)" stroke-width="1.5" />
  <line x1="524" y1="250" x2="536" y2="250" stroke="var(--muted)" stroke-width="1.5" />

  <g font-family="Inter, sans-serif" font-size="21" font-weight="700" text-anchor="middle" dominant-baseline="central">
    <g>
      <line x1="62" y1="212" x2="62" y2="188" stroke="var(--ink-soft)" stroke-width="1.5" />
      <circle cx="62" cy="174" r="19" fill="var(--steel)" />
      <text x="62" y="174" fill="#fff">1</text>
    </g>
    <g>
      <line x1="160" y1="225" x2="160" y2="258" stroke="var(--ink-soft)" stroke-width="1.5" />
      <circle cx="160" cy="279" r="19" fill="var(--amber)" />
      <text x="160" y="279" fill="#fff">2</text>
    </g>
    <g>
      <line x1="280" y1="250" x2="280" y2="258" stroke="var(--ink-soft)" stroke-width="1.5" />
      <circle cx="280" cy="279" r="19" fill="var(--signal)" />
      <text x="280" y="279" fill="#fff">3</text>
    </g>
    <g>
      <circle cx="530" cy="279" r="19" fill="var(--muted)" />
      <text x="530" y="279" fill="#fff">4</text>
      <line x1="530" y1="256" x2="530" y2="262" stroke="var(--ink-soft)" stroke-width="1.5" />
    </g>
  </g>
</svg>
