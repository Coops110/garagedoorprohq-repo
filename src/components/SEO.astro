---
import {
  SITE, GA_ID, GSC_VERIFICATION,
  CONSENT_REQUIRED_REGIONS, CONSENT_STORAGE_KEY,
} from '../lib/site.js';

const {
  title,
  description = SITE.description,
  canonical,          // relative path, e.g. "/garage-door-repair/texas/"
  image,              // OG image path; falls back to the site card below
  imageAlt,           // describes the card, not the page
  noindex = false,
  // Only meaningful alongside noindex. `noindex` on its own emits
  // "noindex, nofollow", which is right for a dead end like /404/ or
  // /get-listed/thanks/ -- there is nothing beyond them worth crawling.
  //
  // It is WRONG for a thin city page. Those pages are the only internal link
  // to the listings inside them, so nofollow would tell Google to stop
  // following the links to 85 listing pages, 8 of them licence-badged. The
  // listings are in the sitemap independently, but a page reachable only by
  // sitemap on a domain with almost nothing indexed is close to orphaned.
  //
  // "noindex, follow" is the standard directive for exactly this: do not
  // index this thin page, do keep crawling through it.
  followLinks = false,
  schemas = [],       // array of JSON-LD objects
  type = 'website',
} = Astro.props;

const base = SITE.domain.replace(/\/$/, '');
const canonicalUrl = canonical ? base + canonical : base + Astro.url.pathname;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

// Every page gets a share card. Without a default, a page that forgot to pass
// one shared as a bare text stub — which is what every page on this site did
// until these existed. Cards are pre-rendered PNGs in public/og/ (generated by
// scripts/build-og-images.py) because no major consumer will render an SVG
// og:image, so the inline-SVG approach used everywhere else cannot work here.
const OG_FALLBACK = '/og/default.png';
const ogPath = image || OG_FALLBACK;
const ogImage = ogPath.startsWith('http') ? ogPath : base + ogPath;
const ogImageAlt = imageAlt
  || `${SITE.name} — garage door cost guides and a directory of local companies`;

// JSON.stringify does not escape "<", so a business name/address containing
// "</script><script>" (this data comes from Overture/OSM, unauthenticated
// and externally editable, see src/lib/schema.js) would break out of the
// JSON-LD tag and execute as live HTML for every visitor. U+2028/U+2029 are
// valid JSON but invalid unescaped JS, so those are escaped too.
function safeJsonLd(obj) {
  return JSON.stringify(obj)
    .replace(/</g, String.raw`\u003c`)
    .replace(/\u2028/g, String.raw`\u2028`)
    .replace(/\u2029/g, String.raw`\u2029`);
}
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content={followLinks ? 'noindex, follow' : 'noindex, nofollow'} />}
{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

<!-- Fonts are self-hosted from /fonts/ — see the @font-face block at the top
     of global.css for why. Preloading them here rather than relying on the
     stylesheet to reveal them is the point of the exercise: the bundled CSS
     is itself a render-blocking request, so a font referenced only from
     inside it cannot start downloading until that request completes. These
     two start immediately, in parallel with the CSS, from our own origin —
     no preconnect needed, because there is no third-party origin left.

     `crossorigin` is required on a font preload even same-origin: fonts are
     always fetched in CORS mode, and without it the browser downloads the
     file twice — once for the preload, once for the real request. -->
<link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/sora-latin-var.woff2" as="font" type="font/woff2" crossorigin />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<!-- Declaring the dimensions lets a consumer reserve the right box on first
     fetch instead of guessing and re-laying-out once the image arrives. -->
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Icons / theme -->
{/* The SVG icon alone left /favicon.ico, /apple-touch-icon.png and
    /logo.svg all 404ing, which the 2026-10-21 audit picked up. Plenty of
    consumers never read this <head> at all and just request the legacy
    paths by convention — iOS home screens, Windows tiles, feed readers,
    link unfurlers, and the bare /favicon.ico fetch most crawlers still
    make — so each of those was a 404 logged against the domain.
    Rasters are generated by scripts/build-icons.py. */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" sizes="any" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#1B222B" />

<!-- JSON-LD structured data -->
{schemas.map((s) => (
  <script type="application/ld+json" set:html={safeJsonLd(s)} />
))}

<!-- Google AdSense (loads only once a publisher ID is set) -->
{SITE.adsensePublisherId && (
  <script
    async
    src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsensePublisherId}`}
    crossorigin="anonymous"
  ></script>
)}

<!-- Google Analytics 4 — production builds only, so `npm run dev`
     sessions never appear as real traffic.

     Consent Mode v2: the `consent default` command must reach dataLayer
     before gtag.js processes it, so the inline block comes first and the
     library loads async after. In UK/EEA/CH storage starts denied (GA sends
     cookieless pings until the visitor accepts); elsewhere it starts
     granted, since opt-in consent is not required there. Google resolves
     the region server-side from IP, which is far more reliable than
     guessing location in the browser. -->
{GA_ID && import.meta.env.PROD && (
  <>
    <script is:inline define:vars={{ GA_ID, CONSENT_REQUIRED_REGIONS, CONSENT_STORAGE_KEY }}>
      // Assigned to window explicitly: Astro wraps define:vars scripts in an
      // IIFE, so a bare `function gtag(){}` would be function-scoped and any
      // gtag('event', ...) call elsewhere on the page would throw.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){ window.dataLayer.push(arguments); };

      // 0. Global Privacy Control, honored everywhere and ahead of everything
      //    else. GPC is a browser-level "do not sell or share" signal, and
      //    roughly a dozen US states now require a business to act on it --
      //    California, Colorado, Connecticut, Delaware, Minnesota, Montana,
      //    Nebraska, New Hampshire, New Jersey, Oregon and Texas among them.
      //    Colorado's AG has published binding technical specifications for
      //    it, and the largest CCPA settlement to date (Healthline, $1.55m,
      //    July 2025) turned partly on a failure to honor these signals.
      //
      //    This matters here precisely BECAUSE the banner is EU/UK-only. US
      //    state law is an opt-OUT regime, so a consent banner is not what it
      //    asks for -- it asks that a visitor who has already opted out at the
      //    browser level is not tracked. Without this the site had no opt-out
      //    mechanism at all for the audience that makes up most of its
      //    traffic. A denied default here cannot be overridden by the grants
      //    below, because this runs first and sets the saved-choice path to
      //    skip.
      var gpc = false;
      try { gpc = navigator.globalPrivacyControl === true; } catch (e) { gpc = false; }
      window.garageDoorProHQGPC = gpc;

      if (gpc) {
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
        });
      }

      // 1. Consent-required regions: deny until the visitor chooses.
      //    wait_for_update holds tags briefly so a fast click still counts.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        region: CONSENT_REQUIRED_REGIONS,
        wait_for_update: 500,
      });

      // 2. Everywhere else: granted. A more specific region always wins
      //    over this, regardless of command order.
      //
      //    Skipped entirely under GPC. Both this and the GPC block above are
      //    region-less defaults, so without the guard the later command would
      //    simply overwrite the earlier one and the opt-out signal would be
      //    silently discarded -- the exact failure the Healthline settlement
      //    was about.
      if (!gpc) {
        gtag('consent', 'default', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
        });
      }

      // 3. Re-apply a previously saved choice on repeat visits.
      //
      //    A stored 'accepted' is NOT re-applied under GPC. The stored choice
      //    may predate the visitor turning the signal on, and the browser
      //    signal is the more recent statement of intent, so it wins. A
      //    stored 'declined' still applies either way -- it agrees with GPC.
      try {
        var saved = JSON.parse(localStorage.getItem(CONSENT_STORAGE_KEY) || 'null');
        if (saved && saved.choice && !(gpc && saved.choice === 'accepted')) {
          var state = saved.choice === 'accepted' ? 'granted' : 'denied';
          gtag('consent', 'update', {
            ad_storage: state,
            ad_user_data: state,
            ad_personalization: state,
            analytics_storage: state,
          });
        }
      } catch (e) { /* private mode / storage disabled — defaults stand */ }

      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  </>
)}
