---
import { SITE } from '../lib/site.js';
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand-mark" aria-hidden="true">G</span>
      Garage<em>Door</em>HQ
    </a>
    <nav class="nav-links" id="nav" aria-label="Main">
      <a href="/garage-door-repair/">Find a Pro</a>
      <a href="/guides/">Cost Guides</a>
      <a href="/guides/hiring-a-garage-door-company/">How to Hire</a>
      <a href="/glossary/">Glossary</a>
      <a href="/garage-door-repair/" class="nav-cta">Search Directory</a>
    </nav>
    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav"
    >☰</button>
  </div>
</header>
<script>
  const t = document.getElementById('navToggle');
  const n = document.getElementById('nav');
  t?.addEventListener('click', () => {
    const open = n?.classList.toggle('open');
    // aria-expanded has to track the real state, or a screen reader
    // announces a permanently collapsed menu.
    t.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
