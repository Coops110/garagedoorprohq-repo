---
import { telHref, formatPhone, siteFactsFor } from '../lib/data.js';

// ─────────────────────────────────────────────────────────────
//  There is no star rating on this card, and there must not be one.
//  The only business data source this site may lawfully republish
//  (Overture / Foursquare, Apache 2.0) carries no ratings. See the note at
//  the top of src/lib/data.js.
//
//  What the card shows instead is what we can actually stand behind:
//  where the business is, what the source says it does, whether a state
//  license was verified, and a phone number that works.
// ─────────────────────────────────────────────────────────────
const { biz } = Astro.props;
const url = `/garage-door-repair/${biz.stateSlug}/${biz.citySlug}/${biz.slug}/`;
const tel = telHref(biz.phone);

// The card used to tag every business with its Overture source category, and
// 402 of 780 listings carry the identical one — "Garage door service". On a
// city page that is 60-odd cards wearing the same label, which is a straight
//-faced illustration of the audit's "about 70% boilerplate" finding.
//
// Where a company's own website lists what it actually does, show that
// instead: 105 distinct service combinations across 448 listings, against a
// top Overture category covering more than half the directory.
//
// The two are NEVER mixed in one row. They are different kinds of statement —
// one is a third-party dataset's category, the other is the company's own
// claim — and a reader who cannot tell which they are looking at is being
// misled by the layout. `selfDeclared` drives both the content and the label.
const facts = siteFactsFor(biz);
const selfDeclared = facts?.services?.length > 0;
const tags = selfDeclared ? facts.services : (biz.services || []);
---
<article class="biz-card">
  <div class="biz-card-head">
    <div style="min-width:0;">
      <h3 class="biz-name"><a href={url}>{biz.name}</a></h3>
      <div class="biz-meta">
        {biz.street ? `${biz.street}, ` : ''}{biz.city}, {biz.stateCode}
        {biz.postalCode ? ` ${biz.postalCode}` : ''}
      </div>
    </div>
    {biz.licenceNumber && (
      <div class="biz-badges">
        <span class="badge badge-license" title="License number matched to an active record on the state register">
          ✓ License verified
        </span>
      </div>
    )}
  </div>

  {tags.length > 0 && (
    <div class="biz-tags">
      {selfDeclared && (
        <span
          class="biz-tag-label"
          title="Listed on the company's own website. Not verified by us."
        >Lists</span>
      )}
      {tags.slice(0, 3).map((t) => <span class="biz-tag">{t}</span>)}
    </div>
  )}

  <div class="biz-foot">
    {tel
      ? <a href={tel} class="btn btn-signal">Call {formatPhone(biz.phone)}</a>
      : <a href={url} class="btn btn-signal">See details</a>}
    <a href={url} class="btn btn-ghost">Profile</a>
  </div>
</article>
